<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GPU 空闲卡监控" Width="1000" Height="690" MinWidth="760" MinHeight="515"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Microsoft YaHei UI" FontSize="14" Foreground="#ECF2FC" Background="#0D111A">
  <Window.Resources>
    <SolidColorBrush x:Key="Ink" Color="#ECF2FC" />
    <SolidColorBrush x:Key="Muted" Color="#A5B3CB" />
    <SolidColorBrush x:Key="Dim" Color="#8494B1" />
    <SolidColorBrush x:Key="Panel" Color="#141B29" />
    <SolidColorBrush x:Key="Line" Color="#2A354A" />
    <SolidColorBrush x:Key="Accent" Color="#86A9FF" />
    <SolidColorBrush x:Key="Mint" Color="#63E3B8" />
    <SolidColorBrush x:Key="Amber" Color="#F6BE78" />
    <LinearGradientBrush x:Key="AvailableSurface" StartPoint="0,0" EndPoint="1,.5">
      <GradientStop Color="#173E36" Offset="0" /><GradientStop Color="#122A29" Offset=".58" /><GradientStop Color="#142429" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CandidateSurface" StartPoint="0,0" EndPoint="1,.5">
      <GradientStop Color="#423326" Offset="0" /><GradientStop Color="#26272A" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="WatchSurface" StartPoint="0,0" EndPoint="1,.5">
      <GradientStop Color="#223049" Offset="0" /><GradientStop Color="#172232" Offset="1" />
    </LinearGradientBrush>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="Small" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{StaticResource Muted}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="Button" TargetType="Button">
      <Setter Property="Background" Value="#192335" />
      <Setter Property="Foreground" Value="{StaticResource Muted}" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="#253552" /></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#9FBBFF" /></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Opacity" Value=".75" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="TileAction" TargetType="Button" BasedOn="{StaticResource Button}">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Padding" Value="5,2" />
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="Background" Value="#192536" />
    </Style>
    <Style x:Key="TileButton" TargetType="Button" BasedOn="{StaticResource Button}">
      <Setter Property="Padding" Value="13,10" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="11" Padding="{TemplateBinding Padding}">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="#1D2A3E" /></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#9FBBFF" /></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Opacity" Value=".75" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Tab" TargetType="Button" BasedOn="{StaticResource Button}">
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Margin" Value="0,0,3,0" />
      <Style.Triggers>
        <Trigger Property="Tag" Value="True">
          <Setter Property="Background" Value="#253756" />
          <Setter Property="BorderBrush" Value="#3D547E" />
          <Setter Property="Foreground" Value="#DCE8FF" />
          <Setter Property="FontWeight" Value="SemiBold" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="Header" TargetType="TextBlock" BasedOn="{StaticResource Small}">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{StaticResource Muted}" />
    </Style>
    <Style x:Key="Bar" TargetType="ProgressBar">
      <Setter Property="Height" Value="4" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="#2B394E" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid ClipToBounds="True">
              <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="2" />
              <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="2" HorizontalAlignment="Left" />
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ScrollPage" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="10" />
      <Setter Property="Background" Value="#1D2739" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Border CornerRadius="4" Background="{TemplateBinding Background}" Padding="2,0">
              <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True"
                     Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" ViewportSize="{TemplateBinding ViewportSize}"
                     Value="{Binding Value, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollPage}" /></Track.DecreaseRepeatButton>
                <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#587198" CornerRadius="3" /></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollPage}" /></Track.IncreaseRepeatButton>
              </Track>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Option" TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="Padding" Value="9,5" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="Item" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter /></Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="#314461" /></Trigger>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="#273B59" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Limit" TargetType="ComboBox">
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="ItemContainerStyle" Value="{StaticResource Option}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton x:Name="Open" Focusable="False" ClickMode="Press"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Box" Background="#192335" BorderBrush="#35435C" BorderThickness="1" CornerRadius="7">
                      <Path Data="M 0 0 L 4 4 L 8 0" Stroke="#A5B3CB" Margin="0,0,8,0" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="Background" Value="#253552" /></Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter Margin="9,0,23,1" IsHitTestVisible="False" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" />
              <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False">
                <Border MinWidth="{Binding ActualWidth, ElementName=Open}" CornerRadius="7" Background="#192335" BorderBrush="#35435C" BorderThickness="1" Padding="0,3">
                  <ScrollViewer><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" /></ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Open" Property="Opacity" Value=".83" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <ItemsPanelTemplate x:Key="HostTiles">
      <UniformGrid Columns="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" />
    </ItemsPanelTemplate>
    <DataTemplate x:Key="ServerTile">
      <Grid Margin="0,0,9,0">
      <Button Style="{StaticResource TileButton}" Tag="server" CommandParameter="{Binding Id}"
              Background="{Binding Background}" BorderBrush="{Binding Border}" ToolTip="{Binding Tooltip}"
              AutomationProperties.Name="{Binding AccessibleName}">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold" MinHeight="24" Margin="0,0,85,0"
                     FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI" TextTrimming="CharacterEllipsis" />
          <Grid Grid.Row="1" Margin="0,3,0,5">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
              <TextBlock Foreground="{StaticResource Muted}" Margin="0,0,12,0"><Run Text="{Binding Idle, Mode=OneWay}" FontSize="27" FontFamily="Consolas" FontWeight="Bold" Foreground="{Binding IdleColor}"/><Run Text=" 空闲" FontSize="12"/></TextBlock>
              <TextBlock Foreground="{StaticResource Muted}"><Run Text="{Binding Low, Mode=OneWay}" FontSize="27" FontFamily="Consolas" FontWeight="Bold" Foreground="{Binding LowColor}"/><Run Text=" 低显存" FontSize="12"/></TextBlock>
            </StackPanel>
            <DockPanel Grid.Column="1" HorizontalAlignment="Right" Margin="5,0,0,0" ToolTip="{Binding ConnectionLabel}">
              <Ellipse Height="6" Width="6" Fill="{Binding ConnectionColor}" Margin="0,0,4,0" />
              <TextBlock Text="{Binding ConnectionLabel}" Foreground="{Binding ConnectionColor}" FontSize="12" TextTrimming="CharacterEllipsis" />
            </DockPanel>
          </Grid>
          <DockPanel Grid.Row="2" Margin="0,0,0,7" MinHeight="22">
            <TextBlock Text="GPU" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource Dim}" Margin="0,0,5,2"/>
            <ItemsControl ItemsSource="{Binding Slots}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate><DataTemplate>
                <Border ToolTip="{Binding SlotHint}" Background="{Binding BadgeBackground}" BorderBrush="{Binding StateColor}" BorderThickness="0,0,0,2" CornerRadius="3" Width="19" Height="20" Margin="0,0,3,2">
                  <TextBlock Text="{Binding GpuIndex}" FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="{Binding StateColor}" HorizontalAlignment="Center"/>
                </Border>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
          </DockPanel>
          <Border Grid.Row="3" BorderThickness="0,1,0,0" BorderBrush="{StaticResource Line}" Padding="0,7,0,0" ToolTip="{Binding DiskHint}">
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" Text="{Binding DiskFree}" FontSize="12" Foreground="{Binding DiskColor}" />
              <Path DockPanel.Dock="Left" Data="M2,8 L4,2 H14 L16,8 V12 H2 Z M2,8 H16 M11,10 H13" Width="14" Height="12" Stroke="{StaticResource Muted}" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
              <TextBlock Text="{Binding DiskPath}" Style="{StaticResource Small}" Margin="0,0,4,0"/>
            </DockPanel>
          </Border>
        </Grid>
      </Button>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,12,0">
        <Button Style="{StaticResource TileAction}" Content="编辑" Tag="edit-server" CommandParameter="{Binding Id}" Foreground="#ACC6FF"
                ToolTip="编辑服务器" AutomationProperties.Name="{Binding EditLabel}" />
        <Button Style="{StaticResource TileAction}" Content="删除" Tag="remove-server" CommandParameter="{Binding Id}" Foreground="#F1ABB2" Margin="4,0,0,0"
                ToolTip="删除服务器" AutomationProperties.Name="{Binding RemoveLabel}" />
      </StackPanel>
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="GpuRow">
      <Border Margin="0,0,0,5" Padding="9,7" Background="{Binding Background}" BorderBrush="{Binding Border}" BorderThickness="1" CornerRadius="8">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*" /><ColumnDefinition Width=".82*" /><ColumnDefinition Width="1.22*" />
            <ColumnDefinition Width=".66*" /><ColumnDefinition Width="1.2*" />
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center" Margin="1,0,10,0">
            <TextBlock Text="{Binding Device}" FontFamily="Cascadia Mono, Consolas" FontWeight="Bold" FontSize="16" />
            <TextBlock Text="{Binding Model}" Style="{StaticResource Small}" ToolTip="{Binding Model}" Margin="0,3,0,0" />
          </StackPanel>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
            <Border Padding="7,3" CornerRadius="5" HorizontalAlignment="Left" Background="{Binding BadgeBackground}">
              <TextBlock Text="{Binding StateLabel}" Foreground="{Binding StateColor}" FontSize="13" FontWeight="SemiBold" />
            </Border>
          </StackPanel>
          <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,17,0">
            <TextBlock Text="{Binding FreeMemory}" FontWeight="Bold" FontSize="19" FontFamily="Cascadia Mono, Consolas" Foreground="{Binding FreeColor}" />
            <ProgressBar Margin="0,3,0,3" Style="{StaticResource Bar}" Value="{Binding MemoryPercent, Mode=OneWay}" Maximum="100"
                         Foreground="{Binding StateColor}" AutomationProperties.Name="显存占用进度" />
            <TextBlock Text="{Binding UsedMemory}" Style="{StaticResource Small}" />
          </StackPanel>
          <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,7,0">
            <TextBlock Text="{Binding Utilization}" FontFamily="Cascadia Mono, Consolas" FontSize="16" />
            <TextBlock Text="{Binding Temperature}" Style="{StaticResource Small}" Margin="0,3,0,0" />
          </StackPanel>
          <StackPanel Grid.Column="4" VerticalAlignment="Center" MinWidth="0">
            <TextBlock Text="{Binding Project}" FontSize="13" TextTrimming="CharacterEllipsis" ToolTip="{Binding ProjectTooltip}" />
            <Button Style="{StaticResource Button}" Tag="processes" CommandParameter="{Binding}" Content="{Binding ProcessesLabel}"
                    Visibility="{Binding ProcessesVisibility}" HorizontalAlignment="Left" FontSize="12" Padding="6,2" Margin="0,4,0,0" />
            <TextBlock Text="{Binding NoProcessesLabel}" Margin="0,3,0,0">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource Small}">
                  <Style.Triggers><DataTrigger Binding="{Binding NoProcessesLabel}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="ProcessRow">
      <Border Background="#151F30" CornerRadius="5" Padding="9,7" Margin="0,0,0,3">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.5*" /><ColumnDefinition Width=".9*" /><ColumnDefinition Width=".64*" />
            <ColumnDefinition Width=".68*" /><ColumnDefinition Width=".75*" /><ColumnDefinition Width=".76*" />
          </Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,12,0">
            <TextBlock Text="{Binding Project}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Tooltip}" />
            <TextBlock Text="{Binding Program}" Style="{StaticResource Small}" Margin="0,3,0,0" />
          </StackPanel>
          <TextBlock Grid.Column="1" Text="{Binding Device}" FontFamily="Cascadia Mono, Consolas" FontSize="13" />
          <TextBlock Grid.Column="2" Text="{Binding Pid}" FontFamily="Cascadia Mono, Consolas" FontSize="13" />
          <TextBlock Grid.Column="3" Text="{Binding User}" FontSize="13" TextTrimming="CharacterEllipsis" Margin="0,0,7,0" />
          <TextBlock Grid.Column="4" Text="{Binding Memory}" FontSize="13" FontFamily="Cascadia Mono, Consolas" Foreground="{StaticResource Mint}" />
          <TextBlock Grid.Column="5" Text="{Binding Runtime}" FontSize="13" />
        </Grid>
      </Border>
    </DataTemplate>
  </Window.Resources>

  <Grid x:Name="LayoutRoot" Margin="20,15,20,10">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Margin="0,0,0,14" LastChildFill="True">
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="9,0,0,0">
        <Border x:Name="LiveBadge" Background="#29253A" BorderBrush="#50446B" BorderThickness="1" CornerRadius="7" Padding="9,5" Margin="0,0,7,0">
          <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="LiveDot" Height="7" Width="7" Fill="#F6BE78" Margin="0,0,6,0" />
            <TextBlock x:Name="LiveText" Text="连接中" FontSize="13" Foreground="#F6BE78" />
          </StackPanel>
        </Border>
        <Button x:Name="AddServer" Style="{StaticResource Button}" Content="＋ 添加服务器" Margin="0,0,7,0" Foreground="#94EDD1" BorderBrush="#356B5C" Background="#1B3832" ToolTip="填写 SSH 账号和要监控的磁盘挂载点" />
        <Button x:Name="IdleAlertsToggle" Style="{StaticResource Button}" Content="空闲提醒 · 开" Margin="0,0,7,0" ToolTip="开启或关闭右下角的空闲显卡提醒" />
        <Button x:Name="Pin" Style="{StaticResource Button}" Content="置顶" Margin="0,0,7,0" ToolTip="让窗口显示在其他窗口上方" />
        <Button x:Name="Pause" Style="{StaticResource Button}" Content="暂停" ToolTip="暂停刷新" />
      </StackPanel>
      <StackPanel Orientation="Horizontal">
        <Image x:Name="AppMark" Width="38" Height="38" Margin="0,0,11,0" RenderOptions.BitmapScalingMode="HighQuality"/>
        <StackPanel>
          <TextBlock Text="显卡资源监控" FontSize="24" FontWeight="Bold" />
          <TextBlock x:Name="Summary" Text="正在读取服务器状态" Style="{StaticResource Small}" FontSize="13" />
        </StackPanel>
      </StackPanel>
    </DockPanel>

    <Border x:Name="Recommendation" Grid.Row="1" Background="{StaticResource WatchSurface}" BorderThickness="1" CornerRadius="11" Margin="0,0,0,10" Padding="16,11">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Border x:Name="RecommendationLine" Width="3" Background="{StaticResource Mint}" CornerRadius="2" Margin="0,2,14,2"/>
        <StackPanel Grid.Column="1">
          <TextBlock x:Name="RecommendationLabel" Text="显卡可用情况" FontWeight="SemiBold" FontSize="12"/>
          <TextBlock x:Name="RecommendationDevice" Text="等待读数" FontSize="27" FontWeight="Bold" Margin="0,1,0,1"/>
          <TextBlock x:Name="RecommendationDetail" Style="{StaticResource Small}" />
        </StackPanel>
        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="14,0,1,0">
          <TextBlock x:Name="RecommendationMemoryLabel" Text="剩余显存" Style="{StaticResource Small}" HorizontalAlignment="Right"/>
          <TextBlock x:Name="RecommendationMemory" Text="—" FontFamily="Cascadia Mono, Consolas" FontSize="30" FontWeight="Bold" HorizontalAlignment="Right"/>
        </StackPanel>
      </Grid>
    </Border>
    <ScrollViewer Grid.Row="2" MaxHeight="155" Margin="0,0,0,12" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <ItemsControl x:Name="ServerTiles" ItemsPanel="{StaticResource HostTiles}" ItemTemplate="{StaticResource ServerTile}" />
    </ScrollViewer>

    <Border Grid.Row="3" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="11" Padding="10,9,10,6">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,6">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="5,0,0,0">
            <Button x:Name="ClearDevice" Style="{StaticResource Button}" FontSize="13" Visibility="Collapsed" Padding="7,5" />
            <Grid x:Name="SearchBox" Width="150" Height="30" Margin="5,0,0,0" Visibility="Collapsed">
              <TextBox x:Name="Search" Padding="6,3" VerticalContentAlignment="Center"
                       Background="#111826" BorderBrush="#35435C" Foreground="{StaticResource Ink}" CaretBrush="{StaticResource Ink}"
                       ToolTip="搜索项目、PID、用户或程序" AutomationProperties.Name="搜索项目、PID、用户或程序" />
              <TextBlock x:Name="SearchHint" Text="搜索项目或 PID" Style="{StaticResource Small}" Margin="8,0,0,0" IsHitTestVisible="False" />
            </Grid>
            <StackPanel x:Name="LimitSettings" Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="低显存上限" FontSize="13" Foreground="{StaticResource Muted}" Margin="0,0,6,0" />
              <ComboBox x:Name="MemoryLimit" Style="{StaticResource Limit}" Width="77" Height="29" AutomationProperties.Name="低显存上限">
                <ComboBoxItem Content="2 GiB" Tag="2" /><ComboBoxItem Content="4 GiB" Tag="4" /><ComboBoxItem Content="8 GiB" Tag="8" />
                <ComboBoxItem Content="12 GiB" Tag="12" /><ComboBoxItem Content="16 GiB" Tag="16" /><ComboBoxItem Content="24 GiB" Tag="24" />
              </ComboBox>
            </StackPanel>
          </StackPanel>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="Candidates" Content="可用显卡" Style="{StaticResource Tab}" />
            <Button x:Name="AllCards" Content="全部显卡" Style="{StaticResource Tab}" />
            <Button x:Name="Processes" Content="计算进程" Style="{StaticResource Tab}" />
            <Button x:Name="Disks" Content="磁盘空间" Style="{StaticResource Tab}" />
            <Button x:Name="ClearServer" Style="{StaticResource Button}" FontSize="12" Padding="7,5" Margin="4,0,0,0" Visibility="Collapsed" />
          </StackPanel>
        </DockPanel>

        <Grid x:Name="CardsPane" Grid.Row="1">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="28" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <TextBlock x:Name="BusyCaption" Text="占用中的卡 · 按剩余显存排序" Foreground="{StaticResource Amber}" FontSize="12" Margin="10,2,0,2" Visibility="Collapsed"/>
          <Grid Grid.Row="1" Margin="10,0,22,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="1.1*" /><ColumnDefinition Width=".82*" /><ColumnDefinition Width="1.22*" />
              <ColumnDefinition Width=".66*" /><ColumnDefinition Width="1.2*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="服务器 / 显卡" Style="{StaticResource Header}" />
            <TextBlock Grid.Column="1" Text="状态" Style="{StaticResource Header}" />
            <TextBlock Grid.Column="2" Text="剩余显存" Style="{StaticResource Header}" />
            <TextBlock Grid.Column="3" Text="利用率" Style="{StaticResource Header}" />
            <TextBlock Grid.Column="4" Text="项目 / 进程" Style="{StaticResource Header}" />
          </Grid>
          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="CardRows" ItemTemplate="{StaticResource GpuRow}" Margin="0,0,4,0" />
          </ScrollViewer>
        </Grid>

        <Grid x:Name="ProcessPane" Grid.Row="1" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="31" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <Grid Margin="10,0,22,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="1.5*" /><ColumnDefinition Width=".9*" /><ColumnDefinition Width=".64*" />
              <ColumnDefinition Width=".68*" /><ColumnDefinition Width=".75*" /><ColumnDefinition Width=".76*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="项目 / 程序" Style="{StaticResource Header}" />
            <TextBlock Grid.Column="1" Text="服务器 / 显卡" Style="{StaticResource Header}" />
            <TextBlock Grid.Column="2" Text="PID" Style="{StaticResource Header}" />
            <TextBlock Grid.Column="3" Text="用户" Style="{StaticResource Header}" />
            <TextBlock Grid.Column="4" Text="占用显存" Style="{StaticResource Header}" />
            <TextBlock Grid.Column="5" Text="运行时长" Style="{StaticResource Header}" />
          </Grid>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="ProcessRows" ItemTemplate="{StaticResource ProcessRow}" Margin="0,0,4,0" />
          </ScrollViewer>
        </Grid>
        <Grid x:Name="DiskPane" Grid.Row="1" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Grid Margin="10,0,22,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width=".7*"/><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width=".85*"/></Grid.ColumnDefinitions>
            <TextBlock Text="服务器" Style="{StaticResource Header}"/><TextBlock Grid.Column="1" Text="挂载点" Style="{StaticResource Header}"/>
            <TextBlock Grid.Column="2" Text="可用空间" Style="{StaticResource Header}"/><TextBlock Grid.Column="3" Text="总容量" Style="{StaticResource Header}"/>
            <TextBlock Grid.Column="4" Text="可用比例" Style="{StaticResource Header}"/>
            <TextBlock Grid.Column="5" Text="采样时间" Style="{StaticResource Header}"/>
          </Grid>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="DiskRows" Margin="0,0,4,0"><ItemsControl.ItemTemplate><DataTemplate>
              <Border Background="#192334" CornerRadius="5" Padding="10,7" Margin="0,0,0,3">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width=".7*"/><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width=".85*"/></Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Host}" FontFamily="Consolas" FontWeight="Bold"/>
                  <TextBlock Grid.Column="1" Text="{Binding Mount}" ToolTip="{Binding Mount}" TextTrimming="CharacterEllipsis" Margin="0,0,6,0"/>
                  <TextBlock Grid.Column="2" Text="{Binding Free}" FontWeight="Bold" FontSize="16" Foreground="{Binding Color}" FontFamily="Consolas"/>
                  <TextBlock Grid.Column="3" Text="{Binding Total}" FontFamily="Consolas"/>
                  <StackPanel Grid.Column="4" Margin="0,0,8,0" VerticalAlignment="Center"><TextBlock Text="{Binding Ratio}" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource Muted}"/>
                    <ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" Foreground="{Binding Color}" Style="{StaticResource Bar}" Margin="0,3,0,0"/>
                  </StackPanel>
                  <TextBlock Grid.Column="5" Text="{Binding SampleTime}" FontFamily="Consolas" Foreground="{StaticResource Muted}" />
                </Grid>
              </Border>
            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          </ScrollViewer>
        </Grid>
        <StackPanel x:Name="Empty" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
          <TextBlock x:Name="EmptyTitle" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center" />
          <TextBlock x:Name="EmptyDetail" FontSize="13" Foreground="{StaticResource Muted}" Margin="0,6,0,0" HorizontalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>

    <DockPanel Grid.Row="4" Margin="1,9,1,0">
      <TextBlock x:Name="LastSample" DockPanel.Dock="Right" Text="等待首次采样" Foreground="{StaticResource Dim}" FontSize="12" Margin="9,0,0,0" />
      <TextBlock x:Name="Rules" Style="{StaticResource Small}" FontSize="12" />
    </DockPanel>
  </Grid>
</Window>
