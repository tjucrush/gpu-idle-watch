<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="显卡空闲提醒" Width="366" SizeToContent="Height" WindowStyle="None"
        ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        ShowActivated="False" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual" UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Microsoft YaHei UI" FontSize="13" Foreground="#EDF6FA">
  <Window.Resources>
    <Style x:Key="Action" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#9CE7CD"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ActionFrame" CornerRadius="5" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ActionFrame" Property="Background" Value="#304941"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="ActionFrame" Property="Background" Value="#3A5B50"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Border Margin="5,4,5,6" CornerRadius="13" BorderBrush="#3B6059" BorderThickness="1" Padding="15,11,15,9">
    <Border.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#18332F" Offset="0"/>
        <GradientStop Color="#132124" Offset=".42"/>
        <GradientStop Color="#151F2B" Offset="1"/>
      </LinearGradientBrush>
    </Border.Background>
    <Border.Effect><DropShadowEffect Color="#080D13" BlurRadius="8" ShadowDepth="2" Opacity=".47"/></Border.Effect>
    <StackPanel>
      <DockPanel LastChildFill="True">
        <Button x:Name="DismissButton" DockPanel.Dock="Right" Style="{StaticResource Action}" Width="26" Height="26"
                Padding="0" ToolTip="关闭提醒" AutomationProperties.Name="关闭提醒">
          <Path Data="M1,1 L9,9 M9,1 L1,9" StrokeThickness="1.4" Stroke="#A3B5BB" Width="10" Height="10" Stretch="Uniform"/>
        </Button>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Image x:Name="NoticeMark" Width="27" Height="27" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
          <TextBlock Text="GPU 空闲卡监控" VerticalAlignment="Center" FontSize="12" Foreground="#A6C1B9"/>
        </StackPanel>
      </DockPanel>
      <TextBlock x:Name="Headline" Margin="0,8,0,8" FontSize="21" FontWeight="SemiBold" Foreground="#F3FAF8"/>
      <ItemsControl x:Name="NoticeCards">
        <ItemsControl.ItemTemplate><DataTemplate>
          <Border BorderBrush="#2C4244" BorderThickness="0,1,0,0" Padding="0,7,0,6">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,6,0">
                <TextBlock Text="{Binding Device}" FontFamily="Consolas" FontSize="18" FontWeight="Bold" Foreground="#F1F7F6"/>
                <TextBlock Text="{Binding Model}" TextTrimming="CharacterEllipsis" Foreground="#9EB0BA" FontSize="11"/>
              </StackPanel>
              <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding FreeMemory}" FontFamily="Consolas" FontSize="18" FontWeight="Bold" Foreground="#83E5BD" HorizontalAlignment="Right"/>
                <TextBlock Text="剩余显存" Foreground="#9EB0BA" FontSize="11" HorizontalAlignment="Right"/>
              </StackPanel>
            </Grid>
          </Border>
        </DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
      <DockPanel Margin="0,4,0,0">
        <Button x:Name="OpenButton" DockPanel.Dock="Right" Style="{StaticResource Action}" Background="#203A34"
                AutomationProperties.Name="查看监控">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="查看监控" FontSize="12" Foreground="#A7EBD2"/>
            <Path Width="10" Height="9" Stretch="Uniform" Margin="5,0,0,0" Stroke="#A7EBD2" StrokeThickness="1.3"
                  Data="M0,5 H9 M5,1 L9,5 L5,9" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <TextBlock x:Name="OverflowLabel" Foreground="#9EB0BA" FontSize="12" VerticalAlignment="Center"/>
      </DockPanel>
    </StackPanel>
  </Border>
</Window>
